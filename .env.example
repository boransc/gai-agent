# Copy this file to .env.local and fill in your own values.
#   cp .env.example .env.local
#
# .env.local is gitignored. Never commit real keys.
# These are read at build time — on Vercel, add them under
# Settings -> Environment Variables and then redeploy, or a variable added
# after the last build will not be picked up.

# ---------------------------------------------------------------------------
# Required: the model provider
# ---------------------------------------------------------------------------
# Google Gemini API key, from https://aistudio.google.com/apikey
# Read automatically by @ai-sdk/google — the name must be exactly this.
# The model itself is chosen in agent/agent.ts (and at runtime by the model
# picker in the chat header; see agent/lib/models.ts for the allowed list).
GOOGLE_GENERATIVE_AI_API_KEY=

# ---------------------------------------------------------------------------
# Optional: document retrieval (the search_documents tool)
# ---------------------------------------------------------------------------
# Only needed if you want the agent to answer from a document corpus.
# Leave these unset and everything else still works — search_documents will
# simply throw if the model tries to call it, and the rest of the quote
# pipeline is unaffected.
#
# These point at a Cloudflare Vectorize index you have already populated.
# Building that index is a separate step, done outside this repo — see the
# "Document retrieval" section of the README.
#
# Create an API token at https://dash.cloudflare.com/profile/api-tokens
# with two permissions: Account > Workers AI > Read, and
# Account > Vectorize > Edit.
CF_ACCOUNT_ID=
CF_API_TOKEN=
# The name of your Vectorize index, e.g. quotes-agent-index
CF_VECTORIZE_INDEX=
